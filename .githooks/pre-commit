#!/bin/sh

changed_files=$(git diff --cached --name-only --diff-filter=ACMRTUXB | tr -d '\r')

plugin_files=$(printf '%s\n' "$changed_files" | grep -Ev '^(\.claude-plugin/plugin\.json|\.githooks/|scripts/bump-version\.js)$' || true)

if [ -n "$plugin_files" ]; then
  node scripts/bump-version.js
  git add .claude-plugin/plugin.json
fi
