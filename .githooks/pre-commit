#!/bin/sh

changed_files=$(git diff --cached --name-only --diff-filter=ACMRTUXB | tr -d '\r')
plugin_files=""

while IFS= read -r file; do
  case "$file" in
    .claude-plugin/plugin.json|.githooks/*|scripts/bump-version.js)
      ;;
    *)
      plugin_files="$plugin_files$file\n"
      ;;
  esac
done <<EOF
$changed_files
EOF

if [ -n "$plugin_files" ]; then
  node scripts/bump-version.js
  git add .claude-plugin/plugin.json
fi
